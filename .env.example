# Names only. Local values go in .env (never committed). Server values live in the secret store (see docs/CHEATSHEET.md).
DATABASE_URL=postgres://postaja:postaja@127.0.0.1:5432/postaja
TEST_DATABASE_URL=postgres://postaja:postaja@127.0.0.1:5432/postaja_test
APP_URL=http://localhost:3000
GIT_SHA=
RUN_MIGRATIONS=
# 1 = run background workers (pg-boss) in this process (ADR-042)
RUN_WORKER=
# Auth (TASK-003a)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
SUPERADMIN_EMAILS=
# Email: SMTP on servers. Locally set EMAIL_TRANSPORT=file to write mails to MAIL_DIR instead of sending.
EMAIL_TRANSPORT=file
MAIL_DIR=.mail
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Post generation (TASK-007). Without a key, generation fails with NOT_CONFIGURED; tests never need it.
ANTHROPIC_API_KEY=
# Later tasks:
# FAL_KEY= EMBEDDINGS_PROVIDER= EMBEDDINGS_API_KEY=
# META_AD_LIBRARY_TOKEN= SENTRY_DSN=
# Object storage (TASK-005b). Local values = the MinIO from docker-compose.yml (create the bucket once in the MinIO console
# at http://localhost:9001, or run the integration tests, which create it). Servers: see docs/CHEATSHEET.md.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=postaja-local
S3_ACCESS_KEY_ID=postaja
S3_SECRET_ACCESS_KEY=postaja-local
S3_FORCE_PATH_STYLE=1
AUTH_MAGIC_LINK_RATE_MAX=
