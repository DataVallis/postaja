# Values are read from the environment (GitHub environment "prod"). Never put a value in this file.
# DATABASE_URL format: postgres://postaja:<POSTGRES_PASSWORD>@postaja-prod-db:5432/postaja_prod
DATABASE_URL=$DATABASE_URL
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
BETTER_AUTH_SECRET=$BETTER_AUTH_SECRET
SMTP_PASSWORD=$SMTP_PASSWORD
S3_ACCESS_KEY_ID=$S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=$S3_SECRET_ACCESS_KEY
ANTHROPIC_API_KEY=$ANTHROPIC_API_KEY
FAL_KEY=$FAL_KEY
# Stripe live mode.
STRIPE_SECRET_KEY=$STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=$STRIPE_WEBHOOK_SECRET
# Backups bucket keys (postaja-backup only).
BACKUP_S3_ACCESS_KEY_ID=$BACKUP_S3_ACCESS_KEY_ID
BACKUP_S3_SECRET_ACCESS_KEY=$BACKUP_S3_SECRET_ACCESS_KEY
