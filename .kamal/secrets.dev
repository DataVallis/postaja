# Values are read from the environment (GitHub environment "dev"). Never put a value in this file.
# DATABASE_URL format: postgres://postaja:<POSTGRES_PASSWORD>@postaja-db:5432/postaja_dev
DATABASE_URL=$DATABASE_URL
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
BETTER_AUTH_SECRET=$BETTER_AUTH_SECRET
SMTP_PASSWORD=$SMTP_PASSWORD
S3_ACCESS_KEY_ID=$S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=$S3_SECRET_ACCESS_KEY
ANTHROPIC_API_KEY=$ANTHROPIC_API_KEY
FAL_KEY=$FAL_KEY
# Stripe test mode (TASK-036); empty = online payment off.
STRIPE_SECRET_KEY=$STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=$STRIPE_WEBHOOK_SECRET
