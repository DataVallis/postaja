# Names only. Local values go in .env (never committed). Server values live in the secret store (see docs/CHEATSHEET.md).
DATABASE_URL=postgres://postaja:postaja@127.0.0.1:5432/postaja
TEST_DATABASE_URL=postgres://postaja:postaja@127.0.0.1:5432/postaja_test
APP_URL=http://localhost:3000
GIT_SHA=
RUN_MIGRATIONS=
# Auth (TASK-003a)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
SUPERADMIN_EMAILS=
# Email: SMTP on servers. Locally set EMAIL_TRANSPORT=file to write mails to MAIL_DIR instead of sending.
EMAIL_TRANSPORT=file
MAIL_DIR=.mail
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Later tasks:
# ANTHROPIC_API_KEY= FAL_KEY= EMBEDDINGS_PROVIDER= EMBEDDINGS_API_KEY=
# S3_ENDPOINT= S3_REGION= S3_BUCKET= S3_ACCESS_KEY_ID= S3_SECRET_ACCESS_KEY= META_AD_LIBRARY_TOKEN= SENTRY_DSN=
